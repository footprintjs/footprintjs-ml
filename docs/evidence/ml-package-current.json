{
  "name": "footprintjs-ml",
  "version": "0.5.0",
  "description": "ML evidence, selection and release APIs with optional trainer, publisher and Lens subpaths",
  "license": "MIT",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./adapter": {
      "types": "./dist/adapter/index.d.ts",
      "import": "./dist/adapter/index.js"
    },
    "./lens": {
      "types": "./lens/session.d.ts",
      "import": "./lens/session.mjs"
    },
    "./conformance": {
      "types": "./dist/conformance/index.d.ts",
      "import": "./dist/conformance/index.js"
    },
    "./release": {
      "types": "./dist/release/index.d.ts",
      "import": "./dist/release/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "tsconfig.json",
    "build.mjs",
    "README.md",
    "ADAPTER.md",
    "DATA-LINEAGE.md",
    "LICENSE",
    "python/*.py",
    "python/footprint_ml_adapter/*.py",
    "python/tests/*.py",
    "python/README.md",
    "lens/session.mjs",
    "lens/session.d.ts",
    "SELECTION.md",
    "RELEASE.md"
  ],
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "typescript": "5.4.5",
    "@types/node": "22.20.5"
  },
  "bin": {
    "footprint-ml-conformance": "./dist/conformance/cli.js"
  }
}
